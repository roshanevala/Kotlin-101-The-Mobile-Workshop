<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_study_lab"
        android:label="${workshopLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudyLab">
        <activity
            android:name="workshop.studylab.StudyPlannerActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="workshop.studylab.MainActivity" android:exported="false" />
    </application>
</manifest>
